  # S3 Bucket for Upload Entities
  UploadEntitiesBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub ${Application}-${Environment}-${AWS::AccountId}-upload-entities
      VersioningConfiguration:
        Status: Enabled
      LifecycleConfiguration:
        Rules:
          - Id: TransitionToGlacierAndExpire
            Status: Enabled
            NoncurrentVersionTransitions:
              - TransitionInDays: 60
                StorageClass: INTELLIGENT_TIERING
            NoncurrentVersionExpiration:
              NoncurrentDays: 90
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      CorsConfiguration:
        CorsRules:
          - AllowedHeaders:
              - "*"
            AllowedMethods:
              - PUT
              - GET
            AllowedOrigins:
              - !Ref CORS
            MaxAge: 3000
      LoggingConfiguration:
        DestinationBucketName: !Ref AccessLoggingBucket
        LogFilePrefix: upload-entities-logs/
      NotificationConfiguration:
        LambdaConfigurations:
          - Event: s3:ObjectCreated:*
            Function: !GetAtt LambdaFunctionImportDataFromS3.Arn
            Filter:
              S3Key:
                Rules:
                  - Name: prefix
                    Value: uploads/
      Tags:
        - Key: application
          Value: !Ref Application
        - Key: environment
          Value: !Ref Environment
        - Key: Name
          Value: !Sub ${Application}-${Environment}-${AWS::AccountId}-upload-entities

  UploadEntitiesBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref UploadEntitiesBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: DenyNonSecureTransport
            Effect: Deny
            Principal: '*'
            Action: 's3:*'
            Resource:
              - !Sub "arn:aws:s3:::${Application}-${Environment}-${AWS::AccountId}-upload-entities"
              - !Sub "arn:aws:s3:::${Application}-${Environment}-${AWS::AccountId}-upload-entities/*"
            Condition:
              Bool:
                aws:SecureTransport: false


  # DynamoDB Table for Upload Entities Metadata
  UploadEntitiesMetadataTable:
    Type: AWS::DynamoDB::Table
    Properties:
      TableName: !Sub ${Application}-${Environment}-upload-entities-metadata
      AttributeDefinitions:
        - AttributeName: "upload_id"
          AttributeType: "S"
        - AttributeName: "uploaded_by"
          AttributeType: "S"
      KeySchema:
        - AttributeName: "upload_id"
          KeyType: "HASH"
      GlobalSecondaryIndexes:
        - IndexName: "uploaded_by_upload_id-index"
          KeySchema:
            - AttributeName: "uploaded_by"
              KeyType: "HASH"
            - AttributeName: "upload_id"
              KeyType: "RANGE"
          Projection:
            ProjectionType: "ALL"
      BillingMode: "PAY_PER_REQUEST"
      TimeToLiveSpecification:
        AttributeName: "record_ttl"
        Enabled: true
      PointInTimeRecoverySpecification:
        PointInTimeRecoveryEnabled: true
      Tags:
        - Key: application
          Value: !Ref Application
        - Key: environment
          Value: !Ref Environment
        - Key: Name
          Value: !Sub ${Application}-${Environment}-upload-entities-metadata
    Metadata:
      cfn_nag:
        rules_to_suppress:
          - id: W28
            reason: "Replacement of this resource is not required, and explicit name of this resource is easy for user to identify the table"
          - id: W74
            reason: "Default encryption is enabled with no additional charge"

  # DynamoDB Table for Data Sources
  DataSourcesDynamoDBTable:
    Type: AWS::DynamoDB::Table
    Properties:
      AttributeDefinitions:
        -
          AttributeName: "data_source_id"
          AttributeType: "S"
        -
          AttributeName: "data_source_name"
          AttributeType: "S"
      KeySchema:
        -
          AttributeName: "data_source_id"
          KeyType: "HASH"
      GlobalSecondaryIndexes:
        - IndexName: "NameIndex"
          KeySchema:
            - AttributeName: "data_source_name"
              KeyType: "HASH"
          Projection:
            ProjectionType: "KEYS_ONLY"
      BillingMode: "PAY_PER_REQUEST"
      TableName: !Sub ${Application}-${Environment}-data_sources
      PointInTimeRecoverySpecification:
        PointInTimeRecoveryEnabled: true
      Tags:
        -
          Key: application
          Value: !Ref Application
        -
          Key: environment
          Value: !Ref Environment
        -
          Key: Name
          Value: !Sub ${Application}-${Environment}-data_sources
    Metadata:
      cfn_nag:
        rules_to_suppress:
          - id: W28
            reason: "Replacement of this resource is not required, and explicit name of this resource is easy for user to identify the table"
          - id: W74
            reason: "Default encryption is enabled with no additional charge"

Outputs:
  GenAiWS:
    Condition: DeploySocketApi
    Value: !Ref GenAISocketsAPI
    
  GenAISocketConnectionsTable:
    Condition: DeploySocketApi
    Value: !Ref GenAISocketConnectionsTable
    
  JobsDynamoDBTable:
    Value: !Ref JobsDynamoDBTable

  JobsDynamoDBTableArn:
    Value: !GetAtt JobsDynamoDBTable.Arn

  RulesDynamoDBTable:
    Value: !Ref RulesDynamoDBTable

  RulesDynamoDBTableArn:
    Value: !GetAtt RulesDynamoDBTable.Arn

  MoveGroupsDynamoDBTable:
    Value: !Ref MoveGroupsDynamoDBTable

  MoveGroupsDynamoDBTableArn:
    Value: !GetAtt MoveGroupsDynamoDBTable.Arn

  MoveGroupRequestsDynamoDBTable:
    Value: !Ref MoveGroupRequestsDynamoDBTable

  MoveGroupRequestsDynamoDBTableArn:
    Value: !GetAtt MoveGroupRequestsDynamoDBTable.Arn

  MoveGroupRequestsTableStreamArn:
    Value: !GetAtt MoveGroupRequestsDynamoDBTable.StreamArn
    
  CustomAssetsDynamoDBTable:
    Value: !Ref CustomAssetsDynamoDBTable

  CustomAssetsDynamoDBTableArn:
    Value: !GetAtt CustomAssetsDynamoDBTable.Arn
  
  BucketDataUploads:
    Value: !Ref UploadEntitiesBucket

  DataSourcesDynamoDBTableArn:
    Value: !GetAtt DataSourcesDynamoDBTable.Arn

  GenAISelectedModelArn:
    Description: The ARN of the best available GenAI model. Set to "Not Supported" if no available model or Bedrock is not supported in the deployed Region.
    Value: !GetAtt BedrockModelSelector.modelArn

  GenAiSupported:
    Description: A value indicating if a preferred Bedrock model is available is this account and region.
    Value: !GetAtt BedrockModelSelector.supported

