  GenAISocketsDeployment:
    Condition: DeploySocketApi
    Type: AWS::ApiGatewayV2::Deployment
    DependsOn:
      - GenAIConnectRoute
      - GenAIDisconnectRoute
      - GenAIMapHeadersRoute
    Properties:
      ApiId: !Ref GenAISocketsAPI
      
  GenAISocketsStage:
    Condition: DeploySocketApi
    Type: AWS::ApiGatewayV2::Stage
    Properties:
      ApiId: !Ref GenAISocketsAPI
      DeploymentId: !Ref GenAISocketsDeployment
      StageName: prod
      AutoDeploy: true

  GenAIConnectRoute:
    Condition: DeploySocketApi
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref GenAISocketsAPI
      RouteKey: $connect
      AuthorizationType: CUSTOM
      AuthorizerId: !Ref GenAIWebSocketAuthorizer
      RouteResponseSelectionExpression: $default
      OperationName: ConnectRoute
      Target: !Join
        - '/'
        - - 'integrations'
          - !Ref ConnectInteg

  GenAIDisconnectRoute:
    Condition: DeploySocketApi
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref GenAISocketsAPI
      RouteKey: $disconnect
      AuthorizationType: NONE
      RouteResponseSelectionExpression: $default
      OperationName: DisconnectRoute
      Target: !Join
        - '/'
        - - 'integrations'
          - !Ref DisconnectInteg

  GenAIMapHeadersRoute:
    Condition: DeploySocketApi
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref GenAISocketsAPI
      RouteKey: MAP_HEADERS
      AuthorizationType: NONE
      RouteResponseSelectionExpression: $default
      OperationName: MapHeadersRoute
      Target: !Join
        - '/'
        - - 'integrations'
          - !Ref MapHeadersInteg

  ConnectInteg:
    Condition: DeploySocketApi
    Type: AWS::ApiGatewayV2::Integration
    Properties:
      ApiId: !Ref GenAISocketsAPI
      IntegrationType: AWS_PROXY
      IntegrationUri: !Sub arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${LambdaFunctionGenAISockets.Arn}/invocations
      
  DisconnectInteg:
    Condition: DeploySocketApi
