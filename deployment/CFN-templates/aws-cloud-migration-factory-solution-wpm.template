  GenAISocketsEventSourceMapping:
    Condition: DeploySocketApi
    Type: AWS::Lambda::EventSourceMapping
    Properties:
      BatchSize: 10
      Enabled: true
      EventSourceArn: !GetAtt GenAISocketsQueue.Arn
      FunctionName: !Ref LambdaFunctionGenAISocketsHandler
      ScalingConfig:
        MaximumConcurrency: 3

