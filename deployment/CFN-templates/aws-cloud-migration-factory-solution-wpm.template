AWSTemplateFormatVersion: "2010-09-09"
Description: "(%%SOLUTION_ID%%-wpm) - The AWS CloudFormation template for deployment of the AWS Cloud Migration Factory Solution - Wave Planning Manager (WPM). Version:%%VERSION%%"

Parameters:
  CodeBucket: # Upload Code in this bucket
    Description: S3 bucket where all the code reside
    Type: String
 
  KeyPrefix:
    Description: S3 key Prefix where all the code reside
    Type: String

  Application:
    Type: String
    Description: Application name, used to name all AWS resources.
    Default: migration-factory
    AllowedPattern: "[-a-z0-9]*"
    ConstraintDescription: Application parameter must be all lower case characters

  Environment:
    Type: String
    Description: Environment name, used to name all AWS resources (.i.e dev, test, prod)
    Default: test
    AllowedPattern: "[-a-z0-9]*"
    ConstraintDescription: Application parameter must be all lower case characters

  LambdaLayerStdPythonLibs:
    Type: String

  LambdaLayerMFUtilsLib:
    Type: String

  LambdaRuntimePython:
    Type: String
    Default: python3.11

  LambdaLayerMFPolicyLib:
    Type: String

  LambdaLayerMFItemsLib:
    Type: String

  CORS:
    Type: String

  CognitoAppClientId:
    Type: String

  CognitoUserPoolId:
    Type: String

  AccessLoggingBucket:
    Type: String

  RoleDynamoDBTableArn:
    Type: String

  PolicyDynamoDBTableArn:
    Type: String

  ServersDynamoDBTableArn:
    Type: String

  AppsDynamoDBTableArn:
    Type: String

  DBsDynamoDBTableArn:
    Type: String

  ServersDynamoDBTableName:
    Type: String

  AppsDynamoDBTableName:
    Type: String

  DBsDynamoDBTableName:
    Type: String

  WavesDynamoDBTableArn:
    Type: String

  WavesDynamoDBTableName:
    Type: String

  SchemaDynamoDBTableName:
    Type: String

  SchemaDynamoDBTableArn:
    Type: String

  UserAPI:
    Type: String

  ToolsAPI:
    Type: String

  ToolsAuthorizer:
    Type: String

  ToolsAPIRootResourceId:
    Type: String

  ToolsApiRequestValidator:
    Type: String

  DeployBedrockGuardrail:
    Type: String
    Description: Deploy Bedrock guardrail for AI features?
    Default: true
    AllowedValues: [ true, false ]

  DeploySocketApi:
    Type: String
    Description: Deploy GenAI Socket API?
    Default: true
    AllowedValues: [ true, false ]

  solutionUUID:
    Type: String
    Description: Unique identifier for this solution deployment

  AnonymousUsageData:
    Type: String
    Description: Send anonymous usage data to AWS
    Default: "Yes"
    AllowedValues: ["Yes", "No"]

Mappings:
  Solution:
    Data:
      SolutionID: '%%SOLUTION_ID%%'
      SolutionVersion: '%%VERSION%%'

Conditions:
  DeployBedrockGuardrail: !Equals [!Ref DeployBedrockGuardrail, true]
  DeploySocketApi: !Equals [!Ref DeploySocketApi, true]

Resources:
  # Bedrock Guardrail for AI safety
  BedrockGuardrail:
    Type: AWS::Bedrock::Guardrail
    Condition: DeployBedrockGuardrail
    Properties:
      Name: !Sub ${Application}-${Environment}-wpm-guardrail
      Description: "Guardrail for WPM AI features to ensure safe and appropriate responses"
      BlockedInputMessaging: "This input is not allowed. Please provide appropriate content."
      BlockedOutputsMessaging: "This response was blocked for safety reasons."
      ContentPolicyConfig:
        FiltersConfig:
          - Type: SEXUAL
            InputStrength: HIGH
            OutputStrength: HIGH
          - Type: VIOLENCE
            InputStrength: HIGH
            OutputStrength: HIGH
          - Type: HATE
            InputStrength: HIGH
            OutputStrength: HIGH
          - Type: INSULTS
            InputStrength: MEDIUM
            OutputStrength: MEDIUM
          - Type: MISCONDUCT
            InputStrength: MEDIUM
            OutputStrength: MEDIUM
          - Type: PROMPT_ATTACK
            InputStrength: HIGH
            OutputStrength: NONE
      Tags:
        - Key: application
          Value: !Ref Application
        - Key: environment
          Value: !Ref Environment

  BedrockGuardrailVersion:
    Type: AWS::Bedrock::GuardrailVersion
    Condition: DeployBedrockGuardrail
    Properties:
      GuardrailIdentifier: !Ref BedrockGuardrail
      Description: "Version 1 of the WPM guardrail"

