      AuthorizerUri: !Sub arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${LambdaFunctionGenAISocketsAuth.Arn}/invocations
      IdentitySource:
        - route.request.header.Sec-WebSocket-Protocol
